{
  "$schema": "https://app.kilo.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "ainstruct": {
      "type": "remote",
      "url": "{env:KD_AINSTRUCT_BASE_URL}/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:KD_MCP_AINSTRUCT_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:KD_MCP_CONTEXT7_TOKEN}"
      }
    },
    "playwright": {
      "type": "remote",
      "url": "http://kilo-playwright-mcp:8931/mcp",
      "enabled": false
    },
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus", "mcp"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["gh", "mcp"],
      "enabled": false
    },
    "gitea": {
      "type": "local",
      "command": ["gitea-mcp", "-t", "stdio"],
      "enabled": false,
      "environment": {
        "GITEA_HOST": "{env:KD_GITEA_HOST}",
        "GITEA_ACCESS_TOKEN": "{env:KD_MCP_GITEA_TOKEN}",
        "GITEA_INSECURE": "{env:KD_GITEA_INSECURE}"
      }
    }
  },
  "instructions": [
    "~/.config/kilo/rules/*.md"
  ],
  "permission": {
    "*": "ask"
  }
}